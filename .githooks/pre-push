#!/usr/bin/env bash
# Block a push that contains personal or sensitive data. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue   # branch deletion
  echo "scan-sensitive: $local_ref -> $remote_ref"
  "$ROOT/scripts/scan-sensitive.sh" "$remote_sha" "$local_sha" || status=1
done
exit $status
